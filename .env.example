# --- Database (required) ---
# In production set this to your MANAGED Postgres connection string. Locally the
# docker-compose stack overrides it to reach the bundled `postgres` service.
DATABASE_URL="postgresql://agentdock:agentdock@localhost:5432/agentdock?schema=public"

# --- Auth (required) ---
# AUTH_SECRET: a random 32+ byte secret (e.g. `openssl rand -base64 32`).
AUTH_SECRET=""
# The app's PUBLIC base URL. Locally http://localhost:3000; in production the
# deployed https origin. NextAuth uses it to build the OAuth callback; it must
# match the redirect URI registered in Google Cloud Console. AUTH_URL is aliased
# to NEXTAUTH_URL at startup, so setting either works.
AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL=""

# Google OAuth (required for sign-in and the Gmail MCP server). Create an OAuth
# client (Web application) in Google Cloud Console; enable the Gmail API; add the
# redirect URI <AUTH_URL>/api/auth/callback/google. In "Testing" mode, add each
# alpha user's Google address as a Test User.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Credential encryption (required) ---
# 32+ byte secret used to AES-256-GCM encrypt BYO provider keys and Google OAuth
# tokens at rest. Generate with `openssl rand -base64 32`. Keep it OUT of the
# database; rotating it invalidates all stored encrypted credentials.
CREDENTIAL_ENCRYPTION_KEY=""

# --- Run-time caps (optional; safe defaults applied in code) ---
#   RUN_MAX_COST_CENTS=50              # per-run spend ceiling
#   USER_DAILY_RUN_COST_CAP_CENTS=200 # per-user daily spend ceiling
#   RUN_MAX_STEPS=16
#   RUN_MAX_TOOL_CALLS=8

# --- Founder tools (optional) ---
# Comma-separated emails allowed to read the activation-funnel summary at
# GET /api/admin/funnel. Empty ⇒ the route 404s for everyone.
FOUNDER_EMAILS=""

# --- Orchestrator (Chunk 2): real model planning call ---
# Provide ONE provider key to enable POST /api/flows/plan. With neither set, the
# endpoint returns 503 and the Builder shows "No model provider configured".
# Keys are read server-side only, never sent to the client, never logged.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# OpenRouter (OpenAI-compatible gateway; sk-or-... key). Models are namespaced,
# e.g. "openai/gpt-4.1" or "anthropic/claude-sonnet-4.5".
OPENROUTER_API_KEY=""
# Force a provider ("anthropic" | "openai" | "openrouter"). Empty = auto
# (anthropic preferred, then openai, then openrouter when multiple are present).
ORCHESTRATOR_PROVIDER=""
# Optional model overrides (defaults: claude-sonnet-4-6 / gpt-4.1 / openai/gpt-4.1).
ANTHROPIC_MODEL=""
OPENAI_MODEL=""
OPENROUTER_MODEL=""
# Optional OpenRouter attribution headers (non-secret):
# OPENROUTER_SITE_URL="" / OPENROUTER_SITE_NAME=""
# Cost governance (defaults applied in code if unset):
#   ORCHESTRATOR_MAX_OUTPUT_TOKENS=4000
#   ORCHESTRATOR_MAX_COST_CENTS_PER_CALL=10
#   ORCHESTRATOR_DAILY_USER_COST_CAP_CENTS=100
#   ORCHESTRATOR_TIMEOUT_MS=60000

# Prototype note:
# Do not put provider API keys or agent secrets in Postgres.
# Future real credentials should live in a secure vault/KMS and only metadata should be stored here.
