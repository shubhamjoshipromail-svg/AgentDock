{
  "name": "agentdock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "worker": "npx tsx servers/worker.ts",
    "build:gmail": "npx tsc servers/gmail/index.ts servers/gmail/server.ts servers/gmail/gmail-tools.ts --outDir servers/gmail/dist --esModuleInterop --module commonjs --target es2022 --resolveJsonModule --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "googleapis": "^173.0.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "typescript": "5.5.3",
    "vitest": "^4.1.8"
  }
}
